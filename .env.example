# ─── Supabase ────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to client, server-only usage only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Site URL ────────────────────────────────────────────────
# Used for OAuth redirect URIs and email confirmation links.
# Must match the origin you use in the browser (include the port, e.g. :3002).
# Local: http://localhost:3000  |  Production: https://echoesofidentity.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
